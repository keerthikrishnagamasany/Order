{
  "name": "order-monorepo",
  "version": "0.4.0",
  "private": true,
  "description": "ORDER — an agent-aware gateway that sorts AI bot traffic, traps the suspicious, and reconstructs attacks offline.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "node --import tsx --test \"packages/**/test/*.test.ts\" \"apps/**/test/*.test.ts\"",
    "demo": "node --import tsx apps/gateway/examples/demo.ts",
    "build": "tsc -b",
    "bench": "node --import tsx scripts/bench.mts",
    "eval": "node --import tsx benchmarks/evaluate.ts",
    "pack:check": "node scripts/pack-check.mjs",
    "rename-scope": "node scripts/rename-scope.mjs"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "tsx": "4.23.15",
    "typescript": "5.6.3"
  },
  "author": "Keerthi Krishna Gamasany"
}
