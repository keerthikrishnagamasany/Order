{
  "name": "@order/web-bot-auth",
  "version": "0.4.0",
  "description": "Verify and sign Web Bot Auth requests (RFC 9421, Ed25519) with SSRF-safe HTTPS key discovery.",
  "author": "Keerthi Krishna Gamasany",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "web-bot-auth",
    "http-message-signatures",
    "rfc9421",
    "ai-agents",
    "ed25519"
  ],
  "homepage": "https://github.com/keerthikrishnagamasany/order#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keerthikrishnagamasany/order.git",
    "directory": "packages/web-bot-auth"
  },
  "bugs": {
    "url": "https://github.com/keerthikrishnagamasany/order/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  }
}
